{
  "name": "onthemap/starter",
  "type": "project",
  "license": "MIT",
  "description": "Wordpress starter theme for On The Map Marketing",
  "keywords": [
    "bedrock",
    "composer",
    "roots",
    "wordpress",
    "wp",
    "wp-config"
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    },
    {
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "require": {
    "php": ">=8.0",
    "blade-ui-kit/blade-heroicons": "^2.1",
    "blade-ui-kit/blade-icons": "^1.5",
    "composer/installers": "^2.2",
    "dompdf/dompdf": "^3.1",
    "guzzlehttp/guzzle": "^7.5",
    "johnbillion/extended-cpts": "^5.0",
    "laravel/serializable-closure": "^1.3",
    "log1x/acf-composer": "^2.1",
    "log1x/crumb": "^1.1",
    "log1x/navi": "^2.0",
    "log1x/sage-directives": "^2.0",
    "masterminds/html5": "^2.8",
    "oscarotero/env": "^2.1",
    "roots/acorn": "^3.1",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/soil": "^4.1",
    "roots/wordpress": "6.4.2",
    "roots/wp-config": "1.0.0",
    "roots/wp-password-bcrypt": "1.1.0",
    "roots/wp-stage-switcher": "^2.2",
    "vlucas/phpdotenv": "^5.5",
    "wpackagist-plugin/safe-svg": "^2.1",
    "wpengine/advanced-custom-fields-pro": "^6.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "johnbillion/query-monitor": "^3.12",
    "laravel/pint": "^1.4",
    "pestphp/pest": "^2.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "roave/security-advisories": "dev-latest",
    "spatie/laravel-ignition": "^1.6",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.1.19"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "acorn": {
      "providers": [
        "App\\Providers\\AssetsServiceProvider",
        "App\\Providers\\BlocksServiceProvider",
        "App\\Providers\\ThemeServiceProvider",
        "App\\Providers\\PostTypesServiceProvider",
        "App\\Providers\\RankMathServiceProvider"
      ]
    },
    "installer-paths": {
      "public/content/mu-plugins/{$name}/": [
        "type:wordpress-muplugin",
        "roots/soil",
        "wpengine/advanced-custom-fields-pro"
      ],
      "public/content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "public/content/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "public/wp"
  },
  "scripts": {
    "lint": "phpcs",
    "format": "pint",
    "format:test": "pint --test",
    "test": "pest",
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  }
}
